# Receiver address — where settled subscription revenue lands (channel payTo).
EVM_ADDRESS=0x...

# Batch-settlement facilitator endpoint. Point at the local facilitator, or a
# hosted one (see README for Coinbase CDP v2).
FACILITATOR_URL=http://localhost:4022

# Recommended: self-managed receiver authorizer key. Channels survive facilitator
# changes when you control this key. Omit to delegate to the facilitator.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Persist channel sessions across restarts (subscriptions survive reboots).
STORAGE_DIR=./data/server

# Channel challenge window in seconds; defaults to 86400 (1 day).
DEFERRED_WITHDRAW_DELAY_SECONDS=900
